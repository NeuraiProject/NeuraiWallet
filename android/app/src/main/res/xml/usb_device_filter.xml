<?xml version="1.0" encoding="utf-8"?>
<!-- USB devices that should offer to open NeuraiWallet (NeuraiHW / ESP32 over
     USB-C). Android can only match by vendor-id / product-id / class here (NOT
     by product name), so we narrow to the ESP32-S3 native USB CDC
     (Espressif 0x303a / product 0x1001). The app then verifies the device is a
     genuine NeuraiHW (info.device === "NeuraiHW") on connect. Values are decimal. -->
<resources>
    <usb-device vendor-id="12346" product-id="4097" /> <!-- 0x303a:0x1001 Espressif ESP32-S3 CDC -->
</resources>
