# Copy this file to `keystore.properties` and fill in your own values.
# The real `keystore.properties` is gitignored — never commit credentials.
#
# To generate a new upload keystore:
#
#   keytool -genkeypair -v -storetype PKCS12 \
#     -keystore android/app/neurai-upload.keystore \
#     -alias neurai-upload \
#     -keyalg RSA -keysize 2048 -validity 10000
#
NEURAI_UPLOAD_STORE_FILE=neurai-upload.keystore
NEURAI_UPLOAD_KEY_ALIAS=neurai-upload
NEURAI_UPLOAD_STORE_PASSWORD=changeme
NEURAI_UPLOAD_KEY_PASSWORD=changeme
